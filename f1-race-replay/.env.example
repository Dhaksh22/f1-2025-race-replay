# =====================================================================
# F1 Race Replay 2025 Web Platform — Configuration Variables
# =====================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
CORS_EXTRA_ORIGINS=http://127.0.0.1:5173,http://localhost:3000

# Cache and Processed Storage Paths
# FastF1 raw HTTP cache
CACHE_DIR=.fastf1-cache
# Pre-computed desktop replay pickles (if available)
COMPUTED_DATA_DIR=computed_data
# Reusable versioned, compressed 2025 processed session data (.json.gz)
PROCESSED_DATA_DIR=data/processed
PROCESSED_CACHE_VERSION=v1

# Data loading behavior
ALLOW_DEMO_FALLBACK=true
PREFER_LIVE_FASTF1=false

# AI Chatbot & Grounded RAG configuration (kept strictly on backend)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=15.0
MAX_CHAT_INPUT_CHARS=2000

# Frontend environment variables (Vite)
# VITE_API_BASE_URL=/api
# VITE_WS_BASE_URL=ws://127.0.0.1:8000/api/ws
